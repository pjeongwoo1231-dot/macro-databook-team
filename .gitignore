.env
__pycache__/
cache/
output/

# 2026-08-26 git 도입 — 이하 신규
# git이 생기기 전까지 되돌리기 수단이 파일 복사뿐이라 *.bak-YYYYMMDD 관례를 썼다.
# 이제 히스토리가 백업이므로 새 bak은 추적하지 않는다(디스크의 기존 파일은 그대로 둔다).
*.bak
*.bak-*
*.bak.*
# 볼트로 복사되는 산출물 — 원본은 DATABOOK_OUTPUT_DIR(macro-data/output)에 있다
Macro/

# 임시 디버그 스크립트·미리보기 (공유본에서 제외)
_f2.py
_fredq.py
_hub_preview.md

# 저장소 폴더를 Obsidian으로 열면 생기는 것들 — 볼트가 아니다
.obsidian/
*.base
*.canvas
무제*

# 볼트 사본은 저장소에 두지 않는다 — 배포는 GitHub Releases의 MacroVault_<날짜>.zip 이다.
# 예전 docs/vault/ 는 260자 초과 경로 395개로 Windows 체크아웃을 깨뜨렸다.
docs/vault/

# 원문 PDF는 git 밖(수집 PC의 macro-data/library-pdfs/)에 둔다 — docs/PDF-INDEX.md 참조
*.pdf
