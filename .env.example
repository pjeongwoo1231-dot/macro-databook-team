# 이 파일을 `.env`로 복사해 값을 채우세요. `.env`는 .gitignore 대상이라 커밋되지 않습니다.
# ★ 키를 이 파일(.env.example)에 직접 쓰지 마세요 — 이건 추적되는 파일입니다.
#
# 키가 하나도 없어도 실행은 됩니다. 키 없는 소스(관세청·BOJ·PBoC·SEC·DBnomics 등)는
# 그대로 수집되고, 키가 필요한 지표만 "수집 실패 (키 없음)"으로 표시됩니다.

# ─────────────────────────── 필수 (이게 있어야 뼈대가 채워짐) ───────────────────────────

# 미국·글로벌 지표의 절반 이상. https://fred.stlouisfed.org/docs/api/api_key.html (즉시 발급)
FRED_API_KEY=

# 한국은행 경제통계시스템. https://ecos.bok.or.kr/api/ (회원가입 후 즉시)
ECOS_API_KEY=

# 통계청 KOSIS. https://kosis.kr/openapi/
KOSIS_API_KEY=

# 공공데이터포털 — 관세청 수출입 등. https://www.data.go.kr/
# ※ 포털 키는 "서비스별 활용신청"이 따로입니다. 신청한 서비스에만 동작합니다.
DATA_GO_KR_KEY=

# ─────────────────────────── 선택 (없으면 해당 지표만 실패) ───────────────────────────

# 일본 e-Stat — 기계수주·광공업생산·가계조사. https://www.e-stat.go.jp/api/ (무료·즉시)
# ※ 발급 폼의 URL 칸은 http://localhost 나 사설 IP를 거부합니다. 공개 저장소 주소를 넣으면 통과합니다.
E_STAT_APP_ID=

# 미 노동통계국 — 없어도 동작(무키 접속, 일 25건 제한). 등록 시 일 500건.
# https://www.bls.gov/developers/api_signature_v2.html
BLS_API_KEY=

# 미 에너지정보청 — 미설정 시 DEMO_KEY 폴백(레이트리밋). https://www.eia.gov/opendata/
EIA_API_KEY=

# 오피넷 국내 유가 — https://www.opinet.co.kr/api (무료·즉시)
OPINET_API_KEY=

# 네이버 뉴스 검색 + 데이터랩 (뉴스 모듈 한국어 기사 보강). 없으면 자동 skip.
# ★ 반드시 "네이버 개발자센터"(developers.naver.com) 키:
#   애플리케이션 등록 → API 설정에서 "검색" 추가 → Client ID / Secret 발급
#   ※ 네이버 클라우드 플랫폼(NCP)은 다른 서비스라 여기서 동작하지 않습니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 금융위 주식대차정보 — 위 DATA_GO_KR_KEY와 **별개로 활용신청**이 필요해 항목을 나눴습니다.
DATA_GO_KR_LENDBORR_KEY=

# 토스증권 공식 API — 국내 수급(투자자별 순매수·공매도·신용·대차) 지표 10개.
# ★ 이 키만은 **각자 본인 것을 발급**합니다. 팀 공용 키가 없는 게 아니라, 있어도 안 통합니다.
#   앱에 등록한 **허용 IP 밖에서 부르면 403**이고, 토큰도 계정당 동시에 하나뿐이라
#   한 키를 둘이 쓰면 서로 401을 만듭니다.
#   1) https://developers.tossinvest.com 로그인 → 앱 생성
#   2) 허용 IP에 **내 공인 IP** 등록 (https://api.ipify.org 로 확인. 사설 IP 192.168.* 은 소용 없음)
#   3) `python -m databook setup` 이 IP까지 띄워 주고, 넣은 뒤 실호출로 확인합니다
#   ⚠ 공유기·회사망·핫스팟은 IP가 바뀝니다. 바뀌면 다시 등록해야 403이 풀립니다.
#   ⚠ 그래도 **절대 공유하지 마세요** — 개인 증권계좌에 연결된 자격증명입니다.
TOSSINVEST_CLIENT_ID=
TOSSINVEST_CLIENT_SECRET=

# ─────────────────────────── 출력 경로 (사람마다 다름) ───────────────────────────

# Obsidian 볼트에도 Data Book을 직접 출력. 비우면 output/ 에만 생성.
# 예: C:\Users\<이름>\MacroVault
OBSIDIAN_VAULT_PATH=

# 산출물 위치를 저장소 바깥으로 옮깁니다(권장).
# ⚠ 저장소가 OneDrive/Dropbox 안에 있으면 매일 바뀌는 대용량 산출물이 계속 동기화됩니다.
# 예: C:\Users\<이름>\macro-data\output
DATABOOK_OUTPUT_DIR=
