# 발급처는 SPEC.md 참조. 이 파일을 .env로 복사해 실제 키를 채우세요.
FRED_API_KEY=
ECOS_API_KEY=
KOSIS_API_KEY=
DATA_GO_KR_KEY=
# 설정하면 Data Book md를 옵시디언 공용 vault에도 직접 출력 (예: C:\Users\me\MacroVault)
OBSIDIAN_VAULT_PATH=

# 선택 키 (없어도 동작 — EIA는 DEMO_KEY 폴백, 오피넷은 수동 안내 표시)
EIA_API_KEY=
OPINET_API_KEY=

# 네이버 뉴스 검색 API (선택 — 뉴스 모듈 한국어 기사 보강). 없으면 자동 skip.
# ★ 반드시 "네이버 개발자센터"(developers.naver.com) 키여야 함:
#    애플리케이션 등록 → API 설정에서 "검색" 추가 → Client ID / Client Secret 발급.
#    ※ 네이버 클라우드 플랫폼(NCP, X-NCP-APIGW-API-KEY)은 다른 서비스라 여기 안 됨(검색 API 없음).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
